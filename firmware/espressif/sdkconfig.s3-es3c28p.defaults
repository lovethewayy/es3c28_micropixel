# LCDWIKI ES3C28P board profile (2.8" IPS ESP32-S3, N16R8).
# ILI9341V accepts direct PSRAM SPI DMA. Two 40-row partial buffers leave more
# of the board's 8 MiB octal PSRAM available to Guest linear memory and assets.
CONFIG_MICROPIXEL_BOARD_ES3C28P=y
CONFIG_MICROPIXEL_ES3C28P_S3_LVGL_DOUBLE_BUFFER=y

CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
# CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM is not set

CONFIG_ESP_LVGL_ADAPTER_ENABLE_PERFORMANCE_TELEMETRY=y
